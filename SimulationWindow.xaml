<Window x:Class="AeroVis.SimulationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AeroVis.Converters"
        Title="AeroVis — Simulation"
        Width="1280" Height="760"
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#0A0A0A"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True">

  <Window.Resources>
    <conv:HexToBrushConverter    x:Key="HexBrush"/>
    <conv:StringToImageConverter x:Key="StrImg"/>

    <Style x:Key="SL" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#505050"/>
      <Setter Property="FontSize"   Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="SV" TargetType="TextBlock">
      <Setter Property="Foreground"   Value="#C8C8C8"/>
      <Setter Property="FontSize"     Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin"       Value="0,2,0,7"/>
    </Style>
    <Style x:Key="SH" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FF6B00"/>
      <Setter Property="FontSize"   Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin"     Value="0,0,0,9"/>
    </Style>

    <Style x:Key="CircuitBtn" TargetType="Button">
      <Setter Property="Background"      Value="#141414"/>
      <Setter Property="Foreground"      Value="#888"/>
      <Setter Property="BorderBrush"     Value="#222"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="8">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1C1C1C"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#FF6B00"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TitleBtn" TargetType="Button">
      <Setter Property="Background"      Value="Transparent"/>
      <Setter Property="Foreground"      Value="#888"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize"        Value="12"/>
      <Setter Property="Width"  Value="40"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#222"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="#0A0A0A" CornerRadius="10"
          BorderBrush="#1A1A1A" BorderThickness="1"
          MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="38"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <Border Grid.Row="0" Background="#0D0D0D" CornerRadius="10,10,0,0"
              BorderBrush="#1A1A1A" BorderThickness="0,0,0,1">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
            <Ellipse Width="8" Height="8" Fill="#FF6B00" Margin="0,0,9,0"/>
            <TextBlock Text="AEROVIS" Foreground="#FF6B00" FontWeight="Bold" FontSize="11"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="SIMULATION MODE" Foreground="#333" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text=" — " Foreground="#222" Margin="4,0"/>
            <TextBlock x:Name="SimCarName" Text="" Foreground="#666" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource TitleBtn}" Foreground="White" Content="─" Click="MinimizeBtn_Click"/>
            <Button Style="{StaticResource TitleBtn}" Foreground="White" Content="□" Click="MaximizeBtn_Click"/>
            <Button Style="{StaticResource TitleBtn}" Foreground="#C00" Content="✕" Click="CloseBtn_Click">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="bd" Background="Transparent" CornerRadius="0,10,0,0">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="bd" Property="Background" Value="#C00000"/>
                      <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 2x2 quadrant layout -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="1"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="1"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Dividers -->
        <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" Background="#1A1A1A"/>
        <Border Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" Background="#1A1A1A"/>

        <!-- ══ TOP-LEFT: Car side profile + race info ══ -->
        <Border Grid.Row="0" Grid.Column="0" Background="#0D0D0D" Padding="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Car side photo -->
            <Border Grid.Row="0" Background="#0A0A0A" Margin="10,10,10,6">
              <Image x:Name="SimCarImage" Stretch="Uniform" Margin="10"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <!-- Race info strip -->
            <Border Grid.Row="1" Background="#111" Margin="10,0,10,10"
                    CornerRadius="6" Padding="12,10">
              <StackPanel>
                <TextBlock x:Name="SimCircuitLabel" Text="No circuit selected"
                           Foreground="#FF6B00" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock x:Name="SimRaceInfo" Text=""
                           Foreground="#888" FontSize="10" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <!-- ══ TOP-RIGHT: Circuit chooser slideshow ══ -->
        <Border Grid.Row="0" Grid.Column="2" Background="#0D0D0D">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="30"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#0A0A0A"
                    BorderBrush="#1A1A1A" BorderThickness="0,0,0,1" Padding="12,0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="CIRCUITS" Foreground="#FF6B00" FontSize="9" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="CircuitCompatLabel" Text="compatible with selected car"
                           Foreground="#333" FontSize="9" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>

            <!-- Circuit image -->
            <Border Grid.Row="1" Background="#0A0A0A" Margin="10,8,10,6">
              <Grid>
                <Image x:Name="CircuitImage" Stretch="Uniform" Margin="20"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <!-- Selected highlight overlay -->
                <Border x:Name="CircuitSelectedBorder" CornerRadius="6"
                        BorderThickness="2" BorderBrush="#FF6B00" Visibility="Collapsed"/>
              </Grid>
            </Border>

            <!-- Circuit name + info -->
            <Border Grid.Row="2" Background="#111" Margin="10,0,10,6"
                    CornerRadius="6" Padding="10,8">
              <Grid>
                <StackPanel>
                  <TextBlock x:Name="CircuitNameText" Text="—"
                             Foreground="White" FontSize="13" FontWeight="Bold"/>
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock x:Name="CircuitCountryText" Text=""
                               Foreground="#555" FontSize="10"/>
                    <TextBlock Text="  ·  " Foreground="#333"/>
                    <TextBlock x:Name="CircuitLengthText" Text=""
                               Foreground="#555" FontSize="10"/>
                    <TextBlock Text="  ·  " Foreground="#333"/>
                    <TextBlock x:Name="CircuitRecordText" Text=""
                               Foreground="#555" FontSize="10"/>
                  </StackPanel>
                </StackPanel>
                <TextBlock x:Name="CircuitIndexText" Text="1 / 1"
                           Foreground="#2A2A2A" FontSize="10"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <!-- Circuit nav + confirm -->
            <Border Grid.Row="3" Background="#0A0A0A"
                    BorderBrush="#1A1A1A" BorderThickness="0,1,0,0">
              <Grid Margin="10,0">
                <!-- Nav arrows + dots -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                  <Button Width="32" Height="32" FontSize="16" Content="‹"
                          Background="#1A1A1A" Foreground="#FF6B00"
                          BorderBrush="#2A2A2A" BorderThickness="1" Cursor="Hand"
                          Click="PrevCircuit_Click">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FF6B00"/>
                            <Setter Property="Foreground" Value="White"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                  <ItemsControl x:Name="CircuitDots" Margin="8,0" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Ellipse Width="5" Height="5" Margin="3,0" Fill="#252525"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Width="32" Height="32" FontSize="16" Content="›"
                          Background="#1A1A1A" Foreground="#FF6B00"
                          BorderBrush="#2A2A2A" BorderThickness="1" Cursor="Hand"
                          Click="NextCircuit_Click">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FF6B00"/>
                            <Setter Property="Foreground" Value="White"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </StackPanel>

                <!-- CONFIRM CIRCUIT button -->
                <Button HorizontalAlignment="Right" Height="30" Padding="16,0"
                        Background="#FF6B00" Cursor="Hand" Click="ConfirmCircuit_Click">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="bd" Background="{TemplateBinding Background}"
                              CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <TextBlock Text="CONFIRM CIRCUIT" Foreground="White"
                                   FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <!-- ══ BOTTOM-LEFT: Speedometer ══ -->
        <Border Grid.Row="2" Grid.Column="0" Background="#0D0D0D">
          <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="WIND SPEED" Foreground="#FF6B00" FontSize="11"
                         FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>

              <Canvas Width="240" Height="160" HorizontalAlignment="Center">
                <!-- Background ring -->
                <Ellipse Canvas.Left="20" Canvas.Top="4" Width="200" Height="200"
                         Stroke="#181818" StrokeThickness="22" Fill="Transparent"/>

                <!-- Green 0-33% -->
                <Path Canvas.Left="20" Canvas.Top="4" Fill="Transparent"
                      Stroke="#1A4A1A" StrokeThickness="22"
                      Data="M 140,192 A 100,100 0 0 1 4,120"/>
                <!-- Yellow 33-66% -->
                <Path Canvas.Left="20" Canvas.Top="4" Fill="Transparent"
                      Stroke="#3A2A00" StrokeThickness="22"
                      Data="M 4,120 A 100,100 0 0 1 100,4"/>
                <!-- Red 66-100% -->
                <Path Canvas.Left="20" Canvas.Top="4" Fill="Transparent"
                      Stroke="#3A0800" StrokeThickness="22"
                      Data="M 100,4 A 100,100 0 0 1 196,120"/>

                <!-- Tick marks -->
                <Line Canvas.Left="120" Canvas.Top="4" X1="0" Y1="0" X2="0" Y2="14"
                      Stroke="#2A2A2A" StrokeThickness="2">
                  <Line.RenderTransform><RotateTransform Angle="-90" CenterX="0" CenterY="100"/></Line.RenderTransform>
                </Line>
                <Line Canvas.Left="120" Canvas.Top="4" X1="0" Y1="0" X2="0" Y2="14"
                      Stroke="#2A2A2A" StrokeThickness="2">
                  <Line.RenderTransform><RotateTransform Angle="-60" CenterX="0" CenterY="100"/></Line.RenderTransform>
                </Line>
                <Line Canvas.Left="120" Canvas.Top="4" X1="0" Y1="0" X2="0" Y2="14"
                      Stroke="#2A2A2A" StrokeThickness="2">
                  <Line.RenderTransform><RotateTransform Angle="-30" CenterX="0" CenterY="100"/></Line.RenderTransform>
                </Line>
                <Line Canvas.Left="120" Canvas.Top="4" X1="0" Y1="0" X2="0" Y2="14"
                      Stroke="#FF6B0066" StrokeThickness="2.5">
                  <Line.RenderTransform><RotateTransform Angle="0" CenterX="0" CenterY="100"/></Line.RenderTransform>
                </Line>
                <Line Canvas.Left="120" Canvas.Top="4" X1="0" Y1="0" X2="0" Y2="14"
                      Stroke="#2A2A2A" StrokeThickness="2">
                  <Line.RenderTransform><RotateTransform Angle="30" CenterX="0" CenterY="100"/></Line.RenderTransform>
                </Line>
                <Line Canvas.Left="120" Canvas.Top="4" X1="0" Y1="0" X2="0" Y2="14"
                      Stroke="#2A2A2A" StrokeThickness="2">
                  <Line.RenderTransform><RotateTransform Angle="60" CenterX="0" CenterY="100"/></Line.RenderTransform>
                </Line>
                <Line Canvas.Left="120" Canvas.Top="4" X1="0" Y1="0" X2="0" Y2="14"
                      Stroke="#2A2A2A" StrokeThickness="2">
                  <Line.RenderTransform><RotateTransform Angle="90" CenterX="0" CenterY="100"/></Line.RenderTransform>
                </Line>

                <!-- Needle -->
                <Line x:Name="SimNeedle" Canvas.Left="120" Canvas.Top="104"
                      X1="0" Y1="14" X2="0" Y2="-76"
                      Stroke="#FF6B00" StrokeThickness="3"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                  <Line.RenderTransform>
                    <RotateTransform x:Name="SimNeedleRotate" CenterX="0" CenterY="0" Angle="-135"/>
                  </Line.RenderTransform>
                </Line>
                <!-- Hub -->
                <Ellipse Canvas.Left="112" Canvas.Top="96" Width="16" Height="16" Fill="#FF6B00"/>
                <Ellipse Canvas.Left="116" Canvas.Top="100" Width="8"  Height="8"  Fill="#0D0D0D"/>

                <!-- Speed text -->
                <TextBlock x:Name="SimSpeedText" Canvas.Left="0" Canvas.Top="118"
                           Text="0" Foreground="White" FontSize="36" FontWeight="Bold"
                           Width="240" TextAlignment="Center"/>
                <TextBlock Canvas.Left="0" Canvas.Top="155"
                           Text="km/h" Foreground="#444" FontSize="12"
                           Width="240" TextAlignment="Center"/>

                <!-- Labels -->
                <TextBlock Canvas.Left="8"   Canvas.Top="140" Text="0"   Foreground="#2A2A2A" FontSize="10"/>
                <TextBlock Canvas.Left="205" Canvas.Top="140" Text="400" Foreground="#2A2A2A" FontSize="10"/>
              </Canvas>

              <TextBlock Text="Connected to wind tunnel dial" Foreground="#282828"
                         FontSize="9" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ══ BOTTOM-RIGHT: Car rear photo ══ -->
        <Border Grid.Row="2" Grid.Column="2" Background="#0D0D0D">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="30"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#0A0A0A"
                    BorderBrush="#1A1A1A" BorderThickness="0,0,0,1" Padding="12,0">
              <TextBlock Text="REAR VIEW" Foreground="#333" FontSize="9"
                         FontWeight="Bold" VerticalAlignment="Center"/>
            </Border>
            <Border Grid.Row="1" Background="#0A0A0A" Margin="10">
              <Image x:Name="SimCarRearImage" Stretch="Uniform" Margin="10"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
          </Grid>
        </Border>

      </Grid>
    </Grid>
  </Border>
</Window>
