<Application x:Class="AeroVis.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- ══════════════════════════════════════════
             GLOBAL COLOR PALETTE
        ══════════════════════════════════════════ -->
        <Color x:Key="BgDeep">#0A0A0A</Color>
        <Color x:Key="BgPanel">#111111</Color>
        <Color x:Key="BgCard">#181818</Color>
        <Color x:Key="BgCardHover">#202020</Color>
        <Color x:Key="AccentOrange">#FF6B00</Color>
        <Color x:Key="AccentOrangeLight">#FF8C33</Color>
        <Color x:Key="AccentRed">#E81416</Color>
        <Color x:Key="TextPrimary">#F0F0F0</Color>
        <Color x:Key="TextSecondary">#888888</Color>
        <Color x:Key="TextMuted">#444444</Color>
        <Color x:Key="BorderSubtle">#222222</Color>
        <Color x:Key="BorderActive">#FF6B00</Color>
        <Color x:Key="StatusGreen">#00C853</Color>
        <Color x:Key="StatusRed">#E81416</Color>

        <SolidColorBrush x:Key="BrushBgDeep"     Color="{StaticResource BgDeep}"/>
        <SolidColorBrush x:Key="BrushBgPanel"    Color="{StaticResource BgPanel}"/>
        <SolidColorBrush x:Key="BrushBgCard"     Color="{StaticResource BgCard}"/>
        <SolidColorBrush x:Key="BrushAccent"     Color="{StaticResource AccentOrange}"/>
        <SolidColorBrush x:Key="BrushAccentLight" Color="{StaticResource AccentOrangeLight}"/>
        <SolidColorBrush x:Key="BrushAccentRed"  Color="{StaticResource AccentRed}"/>
        <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource TextPrimary}"/>
        <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource TextSecondary}"/>
        <SolidColorBrush x:Key="BrushTextMuted"  Color="{StaticResource TextMuted}"/>
        <SolidColorBrush x:Key="BrushBorder"     Color="{StaticResource BorderSubtle}"/>
        <SolidColorBrush x:Key="BrushBorderActive" Color="{StaticResource BorderActive}"/>
        <SolidColorBrush x:Key="BrushStatusGreen" Color="{StaticResource StatusGreen}"/>
        <SolidColorBrush x:Key="BrushStatusRed"  Color="{StaticResource StatusRed}"/>

        <!-- ══════════════════════════════════════════
             SCROLLBAR STYLE (dark, thin)
        ══════════════════════════════════════════ -->
        <Style x:Key="DarkScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#111"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollBarThumb}" Background="#444"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
