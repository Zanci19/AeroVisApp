<Window x:Class="AeroVis.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AeroVis.Converters"
        Title="AeroVis — 1:24 Aerodynamics Simulation"
        Width="1280" Height="760"
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#0A0A0A" FontFamily="Segoe UI"
        WindowStyle="None" AllowsTransparency="True">

  <Window.Resources>
    <conv:HexToBrushConverter       x:Key="HexBrush"/>
    <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
    <conv:StringToImageConverter    x:Key="StrImg"/>

    <Style x:Key="NavBtn" TargetType="Button">
      <Setter Property="Background" Value="#1A1A1A"/>
      <Setter Property="Foreground" Value="#FF6B00"/>
      <Setter Property="BorderBrush" Value="#2A2A2A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FF6B00"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#CC5500"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Bigger spec styles -->
    <Style x:Key="SL" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#505050"/>
      <Setter Property="FontSize"   Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="SV" TargetType="TextBlock">
      <Setter Property="Foreground"   Value="#D0D0D0"/>
      <Setter Property="FontSize"     Value="13"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin"       Value="0,2,0,9"/>
    </Style>
    <Style x:Key="SH" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FF6B00"/>
      <Setter Property="FontSize"   Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin"     Value="0,0,0,10"/>
    </Style>

    <Style x:Key="TitleBtn" TargetType="Button">
      <Setter Property="Background"      Value="Transparent"/>
      <Setter Property="Foreground"      Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize"        Value="12"/>
      <Setter Property="Width"  Value="40"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#222"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="#0A0A0A" CornerRadius="10"
          BorderBrush="#1A1A1A" BorderThickness="1"
          MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="38"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ══ TITLE BAR ══ -->
      <Border Grid.Row="0" Background="#0D0D0D" CornerRadius="10,10,0,0"
              BorderBrush="#1A1A1A" BorderThickness="0,0,0,1">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
            <Ellipse Width="8" Height="8" Fill="#FF6B00" Margin="0,0,9,0"/>
            <TextBlock Text="AEROVIS" Foreground="#FF6B00" FontWeight="Bold"
                       FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="1:24 Aerodynamics Simulation"
                       Foreground="#333" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource TitleBtn}" Content="─" Click="MinimizeBtn_Click"/>
            <Button Style="{StaticResource TitleBtn}" Content="□" Click="MaximizeBtn_Click"/>
            <Button Style="{StaticResource TitleBtn}" Foreground="#C00" Content="✕" Click="CloseBtn_Click">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="bd" Background="Transparent" CornerRadius="0,10,0,0">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="bd" Property="Background" Value="#C00000"/>
                      <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ══ THREE COLUMNS ══ -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="210"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <!-- ════ LEFT SIDEBAR ════ -->
        <Border Grid.Column="0" Background="#0D0D0D"
                BorderBrush="#1A1A1A" BorderThickness="0,0,1,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">

              <!-- Device -->
              <Border Background="#131313" CornerRadius="7"
                      BorderBrush="#1E1E1E" BorderThickness="1"
                      Padding="11" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock Style="{StaticResource SH}" Text="DEVICE"/>
                  <Border Background="#0A0A0A" CornerRadius="5" Height="82"
                          BorderBrush="#202020" BorderThickness="1" Margin="0,0,0,9">
                    <Image Source="pack://application:,,,/Resources/windtunnel.png"
                           Stretch="Uniform" Margin="5"/>
                  </Border>
                  <TextBlock Style="{StaticResource SL}" Text="NAME"/>
                  <TextBlock Style="{StaticResource SV}" Text="{Binding DeviceName}" FontSize="12"/>
                  <TextBlock Style="{StaticResource SL}" Text="MAX MODEL LENGTH"/>
                  <TextBlock Style="{StaticResource SV}" Text="{Binding MaxModelLength}"/>
                  <TextBlock Style="{StaticResource SL}" Text="MAX MODEL WIDTH"/>
                  <TextBlock Style="{StaticResource SV}" Text="{Binding MaxModelWidth}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Style="{StaticResource SL}" Text="STATUS"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}"
                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </StackPanel>
                  <Button Margin="0,9,0,0" Height="30" Background="#181818"
                          BorderBrush="#2A2A2A" BorderThickness="1"
                          Cursor="Hand" Click="ToggleConnect_Click">
                    <Button.Style>
                      <Style TargetType="Button">
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="Button">
                              <Border x:Name="bd" Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                <TextBlock x:Name="txt" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
                              </Border>
                              <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                  <Setter TargetName="txt" Property="Text" Value="⏏  Disconnect"/>
                                  <Setter TargetName="txt" Property="Foreground" Value="#E81416"/>
                                  <Setter TargetName="bd"  Property="BorderBrush" Value="#E81416"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                  <Setter TargetName="txt" Property="Text" Value="⚡  Connect"/>
                                  <Setter TargetName="txt" Property="Foreground" Value="#FF6B00"/>
                                  <Setter TargetName="bd"  Property="BorderBrush" Value="#FF6B00"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </Button.Style>
                  </Button>
                </StackPanel>
              </Border>

              <!-- Active model -->
              <Border Background="#131313" CornerRadius="7"
                      BorderBrush="#1E1E1E" BorderThickness="1"
                      Padding="11" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock Style="{StaticResource SH}" Text="ACTIVE MODEL"/>
                  <TextBlock Text="{Binding SelectedCar.Name}"
                             Foreground="{Binding SelectedCar.AccentHex, Converter={StaticResource HexBrush}}"
                             FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding SelectedCar.Constructor}"
                             Foreground="#3A3A3A" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
              </Border>

              <!-- ════ SPEEDOMETER — no slider, correct arc colors ════ -->
              <Border Background="#131313" CornerRadius="7"
                      BorderBrush="#1E1E1E" BorderThickness="1" Padding="11">
                <StackPanel>
                  <TextBlock Style="{StaticResource SH}" Text="WIND SPEED  —  km/h"/>

                  <Canvas Width="186" Height="132" HorizontalAlignment="Center" Margin="0,4,0,8">
                    <!-- Background ring -->
                    <Ellipse Canvas.Left="18" Canvas.Top="4" Width="150" Height="150"
                             Stroke="#181818" StrokeThickness="18" Fill="Transparent"/>

                    <!-- Green 0→133 km/h  (-135°→-45°, sweep 90°) -->
                    <Path Canvas.Left="18" Canvas.Top="4" Fill="Transparent"
                          Stroke="#1A4A1A" StrokeThickness="18"
                          Data="M 75,4 A 75,75 0 0 0 4,79"/>
                    <!-- Yellow 133→267 km/h  (-45°→+45°, sweep 90°) -->
                    <Path Canvas.Left="18" Canvas.Top="4" Fill="Transparent"
                          Stroke="#3A2A00" StrokeThickness="18"
                          Data="M 4,79 A 75,75 0 0 0 75,154"/>
                    <!-- Red 267→400 km/h  (+45°→+135°, sweep 90°) -->
                    <Path Canvas.Left="18" Canvas.Top="4" Fill="Transparent"
                          Stroke="#3A0800" StrokeThickness="18"
                          Data="M 75,154 A 75,75 0 0 0 146,79"/>

                    <!-- 9 tick marks -->
                    <Line Canvas.Left="93" Canvas.Top="4" X1="0" Y1="0" X2="0" Y2="12" Stroke="#2A2A2A" StrokeThickness="2">
                      <Line.RenderTransform><RotateTransform Angle="-90" CenterX="0" CenterY="75"/></Line.RenderTransform>
                    </Line>
                    <Line Canvas.Left="93" Canvas.Top="4" X1="0" Y1="0" X2="0" Y2="12" Stroke="#2A2A2A" StrokeThickness="2">
                      <Line.RenderTransform><RotateTransform Angle="-67" CenterX="0" CenterY="75"/></Line.RenderTransform>
                    </Line>
                    <Line Canvas.Left="93" Canvas.Top="4" X1="0" Y1="0" X2="0" Y2="12" Stroke="#2A2A2A" StrokeThickness="2">
                      <Line.RenderTransform><RotateTransform Angle="-45" CenterX="0" CenterY="75"/></Line.RenderTransform>
                    </Line>
                    <Line Canvas.Left="93" Canvas.Top="4" X1="0" Y1="0" X2="0" Y2="12" Stroke="#2A2A2A" StrokeThickness="2">
                      <Line.RenderTransform><RotateTransform Angle="-22" CenterX="0" CenterY="75"/></Line.RenderTransform>
                    </Line>
                    <Line Canvas.Left="93" Canvas.Top="4" X1="0" Y1="0" X2="0" Y2="12" Stroke="#FF6B0077" StrokeThickness="2.5">
                      <Line.RenderTransform><RotateTransform Angle="0" CenterX="0" CenterY="75"/></Line.RenderTransform>
                    </Line>
                    <Line Canvas.Left="93" Canvas.Top="4" X1="0" Y1="0" X2="0" Y2="12" Stroke="#2A2A2A" StrokeThickness="2">
                      <Line.RenderTransform><RotateTransform Angle="22" CenterX="0" CenterY="75"/></Line.RenderTransform>
                    </Line>
                    <Line Canvas.Left="93" Canvas.Top="4" X1="0" Y1="0" X2="0" Y2="12" Stroke="#2A2A2A" StrokeThickness="2">
                      <Line.RenderTransform><RotateTransform Angle="45" CenterX="0" CenterY="75"/></Line.RenderTransform>
                    </Line>
                    <Line Canvas.Left="93" Canvas.Top="4" X1="0" Y1="0" X2="0" Y2="12" Stroke="#2A2A2A" StrokeThickness="2">
                      <Line.RenderTransform><RotateTransform Angle="67" CenterX="0" CenterY="75"/></Line.RenderTransform>
                    </Line>
                    <Line Canvas.Left="93" Canvas.Top="4" X1="0" Y1="0" X2="0" Y2="12" Stroke="#2A2A2A" StrokeThickness="2">
                      <Line.RenderTransform><RotateTransform Angle="90" CenterX="0" CenterY="75"/></Line.RenderTransform>
                    </Line>

                    <!-- Needle -->
                    <Line Canvas.Left="93" Canvas.Top="79"
                          X1="0" Y1="12" X2="0" Y2="-58"
                          Stroke="#FF6B00" StrokeThickness="2.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                      <Line.RenderTransform>
                        <RotateTransform CenterX="0" CenterY="0" Angle="{Binding NeedleAngle}"/>
                      </Line.RenderTransform>
                    </Line>
                    <Ellipse Canvas.Left="86" Canvas.Top="72" Width="14" Height="14" Fill="#FF6B00"/>
                    <Ellipse Canvas.Left="89" Canvas.Top="75" Width="8"  Height="8"  Fill="#0D0D0D"/>

                    <!-- Speed readout -->
                    <TextBlock Canvas.Left="0" Canvas.Top="90"
                               Text="{Binding WindSpeedDisplay}"
                               Foreground="White" FontSize="28" FontWeight="Bold"
                               Width="186" TextAlignment="Center"/>
                    <TextBlock Canvas.Left="0" Canvas.Top="120"
                               Text="km/h" Foreground="#444" FontSize="11"
                               Width="186" TextAlignment="Center"/>

                    <!-- Scale labels -->
                    <TextBlock Canvas.Left="4"   Canvas.Top="110" Text="0"   Foreground="#2A2A2A" FontSize="9"/>
                    <TextBlock Canvas.Left="154" Canvas.Top="110" Text="400" Foreground="#2A2A2A" FontSize="9"/>
                  </Canvas>

                  <!-- Progress bar only (no slider) -->
                  <Border Height="5" Background="#141414" CornerRadius="3" Margin="4,0,4,0">
                    <Border x:Name="SpeedBar" CornerRadius="3"
                            HorizontalAlignment="Left" Height="5" Width="0">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                          <GradientStop Color="#1A8A1A" Offset="0"/>
                          <GradientStop Color="#FFAA00" Offset="0.5"/>
                          <GradientStop Color="#E81416" Offset="1"/>
                        </LinearGradientBrush>
                      </Border.Background>
                    </Border>
                  </Border>

                  <TextBlock Text="Dial input — ready to connect"
                             Foreground="#282828" FontSize="9"
                             HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- ════ CENTRE ════ -->
        <Grid Grid.Column="1" Background="#0A0A0A">
          <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
          </Grid.RowDefinitions>

          <!-- Breadcrumb -->
          <Border Grid.Row="0" Background="#0D0D0D"
                  BorderBrush="#1A1A1A" BorderThickness="0,0,0,1" Padding="12,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="MODELS" Foreground="#282828" FontSize="9" FontWeight="Bold"/>
              <TextBlock Text=" › " Foreground="#1C1C1C" Margin="3,0"/>
              <TextBlock Text="{Binding SelectedCar.Constructor}" Foreground="#3A3A3A" FontSize="9"/>
              <TextBlock Text=" › " Foreground="#1C1C1C" Margin="3,0"/>
              <TextBlock Text="{Binding SelectedCar.Season}" Foreground="#FF6B00" FontSize="9" FontWeight="Bold"/>
            </StackPanel>
          </Border>

          <!-- ══ 2×2 inside one border ══ -->
          <Border Grid.Row="1" Margin="10,8,10,4" Background="#0C0C0C" CornerRadius="8"
                  BorderBrush="{Binding SelectedCar.AccentHex, Converter={StaticResource HexBrush}}"
                  BorderThickness="1">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- TOP-LEFT: Side -->
              <Grid Grid.Row="0" Grid.Column="0">
                <Image Source="{Binding SelectedCar.ImageSide, Converter={StaticResource StrImg}}"
                       Stretch="Uniform" Margin="10" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                        Margin="8,6,0,0" Background="#000000CC" CornerRadius="3" Padding="6,2">
                  <TextBlock Text="SIDE VIEW" Foreground="#555" FontSize="9" FontWeight="Bold"/>
                </Border>
              </Grid>

              <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" Background="#1C1C1C"/>

              <!-- TOP-RIGHT: Front -->
              <Grid Grid.Row="0" Grid.Column="2">
                <Image Source="{Binding SelectedCar.ImageFront, Converter={StaticResource StrImg}}"
                       Stretch="Uniform" Margin="10" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                        Margin="8,6,0,0" Background="#000000CC" CornerRadius="3" Padding="6,2">
                  <TextBlock Text="FRONT VIEW" Foreground="#555" FontSize="9" FontWeight="Bold"/>
                </Border>
              </Grid>

              <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="#1C1C1C"/>

              <!-- BOTTOM-LEFT: Rear -->
              <Grid Grid.Row="2" Grid.Column="0">
                <Image Source="{Binding SelectedCar.ImageRear, Converter={StaticResource StrImg}}"
                       Stretch="Uniform" Margin="10" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                        Margin="8,6,0,0" Background="#000000CC" CornerRadius="3" Padding="6,2">
                  <TextBlock Text="REAR VIEW" Foreground="#555" FontSize="9" FontWeight="Bold"/>
                </Border>
              </Grid>

              <!-- BOTTOM-RIGHT: Info card -->
              <Grid Grid.Row="2" Grid.Column="2">
                <StackPanel Margin="16,12,16,12" VerticalAlignment="Center">
                  <TextBlock Text="{Binding SelectedCar.Name}"
                             Foreground="{Binding SelectedCar.AccentHex, Converter={StaticResource HexBrush}}"
                             FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,3"/>
                  <TextBlock Text="{Binding SelectedCar.Constructor}"
                             Foreground="#4A4A4A" FontSize="11" Margin="0,0,0,10"/>

                  <UniformGrid Columns="3" Margin="0,0,0,10">
                    <StackPanel Margin="0,0,6,0">
                      <TextBlock Text="POWER" Foreground="#484848" FontSize="9" FontWeight="Bold"/>
                      <TextBlock Text="{Binding SelectedCar.Power}"
                                 Foreground="#FF6B00" FontSize="11" FontWeight="Bold"
                                 TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,6,0">
                      <TextBlock Text="TOP SPEED" Foreground="#484848" FontSize="9" FontWeight="Bold"/>
                      <TextBlock Text="{Binding SelectedCar.TopSpeed}"
                                 Foreground="#FF6B00" FontSize="11" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="WEIGHT" Foreground="#484848" FontSize="9" FontWeight="Bold"/>
                      <TextBlock Text="{Binding SelectedCar.Weight}"
                                 Foreground="#FF6B00" FontSize="11" FontWeight="Bold"
                                 TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                  </UniformGrid>

                  <Border Height="1" Background="#1E1E1E" Margin="0,0,0,10"/>

                  <TextBlock Text="DRIVERS" Foreground="#484848" FontSize="9" FontWeight="Bold" Margin="0,0,0,6"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Border Background="{Binding SelectedCar.AccentHex, Converter={StaticResource HexBrush}}"
                            CornerRadius="4" Padding="9,4" Margin="0,0,7,0">
                      <TextBlock Text="{Binding SelectedCar.Driver1}"
                                 Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <Border Background="#1C1C1C" BorderBrush="#2A2A2A" BorderThickness="1"
                            CornerRadius="4" Padding="9,4">
                      <TextBlock Text="{Binding SelectedCar.Driver2}" Foreground="#999" FontSize="11"/>
                    </Border>
                  </StackPanel>

                  <Button Height="34" Cursor="Hand"
                          Background="{Binding SelectedCar.SelectButtonHex, Converter={StaticResource HexBrush}}"
                          Click="SelectCar_Click">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5">
                          <TextBlock Text="SELECT FOR SIMULATION" Foreground="White"
                                     FontSize="11" FontWeight="Bold"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>

          <!-- ══ BOTTOM NAV ══ -->
          <Border Grid.Row="2" Background="#0D0D0D" BorderBrush="#1A1A1A" BorderThickness="0,1,0,0"
                  Padding="0,0,0,8">
            <Grid VerticalAlignment="Bottom" Height="42">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Style="{StaticResource NavBtn}" Content="‹" Margin="0,0,12,0" Click="PrevCar_Click"/>
                <ItemsControl ItemsSource="{Binding Cars}" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Ellipse Width="6" Height="6" Margin="4,0" Fill="#252525"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource NavBtn}" Content="›" Margin="12,0,0,0" Click="NextCar_Click"/>
              </StackPanel>
              <!-- White counter -->
              <TextBlock Text="{Binding SelectedIndexDisplay}"
                         Foreground="White" FontSize="11" FontWeight="Bold"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Margin="0,0,14,0"/>
            </Grid>
          </Border>
        </Grid>

        <!-- ════ RIGHT SPECS ════ -->
        <Border Grid.Column="2" Background="#0D0D0D" BorderBrush="#1A1A1A" BorderThickness="1,0,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">

              <Border Background="#131313" CornerRadius="7" BorderBrush="#1E1E1E" BorderThickness="1"
                      Padding="11" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock Style="{StaticResource SH}" Text="TECHNICAL SPECIFICATIONS"/>
                  <TextBlock Style="{StaticResource SL}" Text="CHASSIS"/>
                  <TextBlock Style="{StaticResource SV}" Text="{Binding SelectedCar.Chassis}"/>
                  <TextBlock Style="{StaticResource SL}" Text="ENGINE"/>
                  <TextBlock Style="{StaticResource SV}" Text="{Binding SelectedCar.Engine}"/>
                  <TextBlock Style="{StaticResource SL}" Text="TRANSMISSION"/>
                  <TextBlock Style="{StaticResource SV}" Text="{Binding SelectedCar.Transmission}"/>
                  <TextBlock Style="{StaticResource SL}" Text="POWER (MAX)"/>
                  <TextBlock Text="{Binding SelectedCar.Power}" Margin="0,2,0,9"
                             Foreground="{Binding SelectedCar.AccentHex, Converter={StaticResource HexBrush}}"
                             FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                  <TextBlock Style="{StaticResource SL}" Text="TOP SPEED"/>
                  <TextBlock Style="{StaticResource SV}" Text="{Binding SelectedCar.TopSpeed}"/>
                  <TextBlock Style="{StaticResource SL}" Text="WEIGHT"/>
                  <TextBlock Style="{StaticResource SV}" Text="{Binding SelectedCar.Weight}"/>
                  <TextBlock Style="{StaticResource SL}" Text="WHEELBASE"/>
                  <TextBlock Style="{StaticResource SV}" Text="{Binding SelectedCar.Wheelbase}"/>
                  <TextBlock Style="{StaticResource SL}" Text="FUEL"/>
                  <TextBlock Style="{StaticResource SV}" Text="{Binding SelectedCar.Fuel}"/>
                  <TextBlock Style="{StaticResource SL}" Text="TYRES"/>
                  <TextBlock Style="{StaticResource SV}" Text="{Binding SelectedCar.Tyres}"/>
                </StackPanel>
              </Border>

              <Border Background="#131313" CornerRadius="7" BorderBrush="#1E1E1E" BorderThickness="1"
                      Padding="11">
                <StackPanel>
                  <TextBlock Style="{StaticResource SH}" Text="TEAM INFORMATION"/>
                  <TextBlock Style="{StaticResource SL}" Text="CONSTRUCTOR"/>
                  <TextBlock Style="{StaticResource SV}" Text="{Binding SelectedCar.Constructor}"/>
                  <TextBlock Style="{StaticResource SL}" Text="SEASON"/>
                  <TextBlock Style="{StaticResource SV}" Text="{Binding SelectedCar.Season}"/>
                  <TextBlock Style="{StaticResource SL}" Text="DRIVER 1"/>
                  <TextBlock Style="{StaticResource SV}" Text="{Binding SelectedCar.Driver1}"/>
                  <TextBlock Style="{StaticResource SL}" Text="DRIVER 2"/>
                  <TextBlock Style="{StaticResource SV}" Text="{Binding SelectedCar.Driver2}"/>
                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>
        </Border>

      </Grid>
    </Grid>
  </Border>
</Window>
